+/* DRI_Mesa.createContext is a private Mesa entry point.  mtgpu supplies
+ * the public createContextAttribs callback instead; keep all attributes and
+ * the driver's error reporting intact rather than assuming a Mesa layout.
+ */
+static __DRIcontext *
+dri2_create_driver_context(struct dri2_egl_display *dri2_dpy, int api,
+                           const __DRIconfig *config, __DRIcontext *shared,
+                           unsigned num_attribs, const uint32_t *attribs,
+                           unsigned *error, void *loader_private)
+{
+   __DRIcreateContextAttribsFunc create = NULL;
+
+   if (dri2_mtgpu_opaque_screen(dri2_dpy)) {
+      if (dri2_dpy->image_driver &&
+          dri2_dpy->image_driver->base.version >= 1)
+         create = dri2_dpy->image_driver->createContextAttribs;
+      if (!create && dri2_dpy->dri2 && dri2_dpy->dri2->base.version >= 3)
+         create = dri2_dpy->dri2->createContextAttribs;
+      if (!create) {
+         *error = __DRI_CTX_ERROR_BAD_API;
+         return NULL;
+      }
+      _eglLog(_EGL_INFO, "MTT compatibility: public DRI context callbacks");
+   } else {
+      create = dri2_dpy->mesa->createContext;
+   }
+
+   return create(dri2_dpy->dri_screen_render_gpu, api, config, shared,
+                 num_attribs, attribs, error, loader_private);
+}
