+static bool
+dri2_mtgpu_opaque_screen(const struct dri2_egl_display *dri2_dpy)
+{
+   return dri2_dpy->driver_name &&
+          strcmp(dri2_dpy->driver_name, "mtgpu") == 0;
+}
