+/* The reviewed MTT 3.1.0 DRI driver rejects IMAGE_LOOKUP versions other
+ * than 1 before creating a screen. Offer the complete v1 callback, which
+ * validates the EGLImage before looking it up; do not change Mesa ABI checks
+ * or expose v2 callbacks under a misleading version. Other drivers retain v2.
+ */
+static const __DRIimageLookupExtension mtgpu_image_lookup_v1 = {
+   .base = {__DRI_IMAGE_LOOKUP, 1},
+   .lookupEGLImage = dri2_lookup_egl_image,
+};
+
+static const __DRIextension *mtgpu_dri2_loader_extensions[] = {
+   &dri2_loader_extension.base,
+   &image_loader_extension.base,
+   &mtgpu_image_lookup_v1.base,
+   &use_invalidate.base,
+   NULL,
+};
+
+static const __DRIextension *mtgpu_image_loader_extensions[] = {
+   &image_loader_extension.base,
+   &mtgpu_image_lookup_v1.base,
+   &use_invalidate.base,
+   NULL,
+};
